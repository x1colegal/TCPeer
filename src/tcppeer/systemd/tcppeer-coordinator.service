[Unit]
Description=TCPeer control-plane coordinator
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tcppeer
Group=tcppeer
ExecStart=/usr/local/bin/tcppeer-coordinator --config /etc/tcppeer/coordinator.toml
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal
RuntimeDirectory=tcppeer
RuntimeDirectoryMode=0750
StateDirectory=tcppeer/coordinator
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tcppeer

[Install]
WantedBy=multi-user.target
